// === ARQUIVO: prisma/schema.prisma ===
generator client {
  provider = "prisma-client-js"
}

datasource db {
  // ==========================================
  // 1. SQL local
  // provider = "sqlite"
  // url      = env("DATABASE_URL")
  // ==========================================

  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. SISTEMA DE USUÁRIOS (NOVO)
// ==========================================
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String?  // Pode ser nulo se decidirmos usar Google
  
  // Relacionamentos: Tudo que pertence a este usuário
  accounts          Account[]
  categories        Category[]
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]
  importRules       ImportRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 2. TABELAS FINANCEIRAS ATUALIZADAS
// ==========================================

model Account {
  id           String        @id @default(uuid())
  name         String
  type         String        
  balance      Decimal       @default(0) 

  transactions Transaction[]
  recurringExpenses RecurringExpense[]
  
  // Vínculo com o Usuário
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Category {
  id           String        @id @default(uuid())
  name         String
  icon         String?
  color        String?
  isThirdParty Boolean       @default(false)

  transactions Transaction[]
  recurringExpenses RecurringExpense[]
  importRules  ImportRule[]

  // Vínculo com o Usuário
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Transaction {
  id          String   @id @default(uuid())
  description String
  amount      Decimal
  date        DateTime
  type        String   @default("expense") 
  isPaid           Boolean   @default(true)  
  installmentId    String?
  installmentLabel String?
  isReimbursed     Boolean   @default(false)

  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  account     Account   @relation(fields: [accountId], references: [id])
  accountId   String

  // Vínculo com o Usuário
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecurringExpense {
  id          String   @id @default(uuid())
  description String
  amount      Decimal
  type        String   
  day         Int      
  
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  account     Account   @relation(fields: [accountId], references: [id])
  accountId   String

  // Vínculo com o Usuário
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ImportRule {
  id         String   @id @default(uuid())
  pattern    String   @unique 
  
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Vínculo com o Usuário
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}